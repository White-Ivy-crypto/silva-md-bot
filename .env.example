.env.example

# Owner number in E.164 format (used to restrict owner-only commands)
OWNER_NUMBER=+2348064543045

# Port for optional status server
PORT=3000

# Path to sqlite DB
DB_PATH=./data/bot.db

# Temporary folder for media
TMP_DIR=./tmp

# Optional: OpenAI key for better summarization (not required)
OPENAI_API_KEY=
